{
    "name": "resterland/rlt3sitepackage",
    "type": "typo3-cms-extension",
    "description": "TYPO3 CMS Sitepackage Starter Kit. Contains website templates, assets, configuration and custom code for my TYPO3 projects.",
    "license": ["GPL-2.0-or-later"],
    "homepage": "https://resterland.com",
    "authors": [
        {
            "name": "Roland Fuhrer",
            "email": "webmaster@resterland.com",
            "role": "Developer"
        }
    ],
    "keywords": [
        "TYPO3 CMS",
        "extension",
        "sitepackage",
        "fluid",
        "yaml",
        "typoscript",
        "tsconfig",
		"LitElement",
		"JavaScript",
		"PHP",
		"HTML5"
    ],
    "require": {
        "typo3/cms-core": "^13.4 || ^14.3",
        "typo3/cms-fluid-styled-content": "^13.4 || ^14.3"
    },
    "suggest": {
    },
    "autoload": {
        "psr-4": {
            "Resterland\\Rlt3sitepackage\\": "Classes/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "rlt3sitepackage"
        }
    },
	"config": {
		"allow-plugins": {
			"typo3/cms-*": true
		}
	}
}
