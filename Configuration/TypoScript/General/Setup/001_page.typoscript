page = PAGE
page {
  typeNum = 0
  shortcutIcon = {$page.meta.favicon}

  headerData {
    // Flip ahead browsing for IE10/11
    // http://msdn.microsoft.com/en-us/library/ie/jj883726(v=vs.85).aspx
    10 = HMENU
    10 {
      special = browse
      special {
        items = prev|next
      }
      1 = TMENU
      1.NO {
        allWrap = <link rel="prev" href="|"> |*| <link rel="next" href="|">
        doNotLinkIt = 1
        stdWrap {
          typolink {
            parameter.data = field:uid
            returnLast = url
          }
        }
      }
    }
  }

  10 = PAGEVIEW
  10 {
    paths {
      10 = EXT:rlt3sitepackage/Resources/Private/PageView/
    }

    variables {
      parentPageTitle = TEXT
      parentPageTitle.data = levelfield:-1:title

      rootPage = TEXT
      rootPage.data = leveluid:0

      applicationContext = TEXT
      applicationContext.value.data = applicationcontext

      siteLanguageNavigationTitle = TEXT
      siteLanguageNavigationTitle.data = siteLanguage:navigationTitle

      siteName = TEXT
      siteName.data = {$config.siteName}
    }
  }


  meta {
    viewport = width=device-width, initial-scale=1
    robots = index,follow
    apple-mobile-web-app-capable = no
    color-scheme = light dark


    X-UA-Compatible = IE=edge
    X-UA-Compatible {
      attribute = http-equiv
    }

    # Google
    google = {$page.meta.google}
    google-site-verification = {$page.meta.google-site-verification}
  }
  #includeJSFooter {
  #   litelement = EXT:rlt3sitepackage/Resources/Public/JavaScript/my-rldropdown.js
  #   litelement.type = module
  #}
}
