page = PAGE
page {
  typeNum = 0
  shortcutIcon = {$meta.favicon}

  # set color-scheme class to body tag
  bodyTagCObject = TEXT
  bodyTagCObject {
    data = sitesettings:rlt3sitepackage.colorScheme
    wrap = <body class=" | ">
  }

  headerData {
    // Flip ahead browsing for IE10/11
    // http://msdn.microsoft.com/en-us/library/ie/jj883726(v=vs.85).aspx
    10 = HMENU
    10 {
      special = browse
      special {
        items = prev|next
      }
      1 = TMENU
      1.NO {
        allWrap = <link rel="prev" href="|"> |*| <link rel="next" href="|">
        doNotLinkIt = 1
        stdWrap {
          typolink {
            parameter.data = field:uid
            returnLast = url
          }
        }
      }
    }
  }

  10 = PAGEVIEW
  10 {
    paths {
      10 = {$page.templates.template_path}
    }

    variables {
      parentPageTitle = TEXT
      parentPageTitle.data = levelfield:-1:title

      rootPage = TEXT
      rootPage.data = leveluid:0

      applicationContext = TEXT
      applicationContext.value.data = applicationcontext

      siteLanguageNavigationTitle = TEXT
      siteLanguageNavigationTitle.data = siteLanguage:navigationTitle

      siteName = TEXT
      siteName.data = {$config.siteName}
    }
  }


  meta {
    apple-mobile-web-app-capable = {$meta.apple-mobile-web-app-capable}
    # Google
    google-site-verification = {$meta.google-site-verification}
  }
}
